{
  "name": "erp-dashboard-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=3010 tsx watch src/index.ts",
    "start": "PORT=3010 tsx src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "tsx scripts/with-env.ts generate",
    "db:push": "tsx scripts/with-env.ts db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2"
  }
}
